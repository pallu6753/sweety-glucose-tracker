# ==========================================
# Sweety - Blood Glucose Tracker
# Environment Configuration Template
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000

# PostgreSQL Database Configuration
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://sweety_app:your_local_password_here@localhost:5432/sweety_glucose_tracker
TEST_DATABASE_URL=postgresql://sweety_app:your_local_password_here@localhost:5432/sweety_glucose_tracker_test

# Authentication & Session Security
# Generate a cryptographically secure 256-bit random string for production
JWT_SECRET=your_jwt_secret_min_32_characters_random_hex_placeholder
JWT_EXPIRES_IN=7d

# CORS & Client Application Origin
CLIENT_URL=http://localhost:5173
